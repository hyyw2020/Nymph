<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0F1115">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NymphAuto"
        android:textColor="#E5E7EB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvScriptName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="尚未导入脚本"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="开启无障碍服务" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="授予悬浮窗权限" />

    <Button
        android:id="@+id/btnImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="导入脚本（自动精灵/.zjs/行格式）" />

    <Button
        android:id="@+id/btnRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="开始录制脚本（不占用录屏权限）" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="脚本库（导入后自动保存，无需重复导入）"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvScriptEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="还没有脚本，点上方「导入脚本」添加"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvScripts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#1F2937"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="查看运行日志" />
</LinearLayout>
